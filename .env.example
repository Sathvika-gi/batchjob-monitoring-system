PORT=5000

# -------------------------------------------------------------
# DATABASE CONNECTION OPTIONS:
# -------------------------------------------------------------
# Option 1: MongoDB Atlas (Standard / Direct URI - RECOMMENDED if SRV fails on Windows/ISP):
# MONGODB_URI=mongodb://<user>:<password>@<node0>:27017,<node1>:27017,<node2>:27017/batch-monitor?ssl=true&replicaSet=<replicaSet>&authSource=admin&retryWrites=true&w=majority

# Option 2: MongoDB Atlas (Standard SRV URI - auto-resolved by backend fallback if Windows DNS blocks UDP 53):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/batch-monitor?retryWrites=true&w=majority

# Option 3: Local Docker MongoDB (run `docker compose up -d`):
# MONGODB_URI=mongodb://127.0.0.1:27017/batch-monitor

# Option 4: Local Native MongoDB Community Server:
MONGODB_URI=mongodb://127.0.0.1:27017/batch-monitor

# -------------------------------------------------------------
# APPLICATION CONFIGURATION:
# -------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
DEMO_MODE=true
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
PREDICTION_MIN_SAMPLES=5
PREDICTION_ANOMALY_MULTIPLIER=1.5
SCHEDULER_INTERVAL_MS=60000
